# Supabase > Settings > API. Public keys are safe to expose; never put database credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Server only. Use the Supabase session pooler (port 5432), URL-encode the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER:5432/postgres
# Supabase requires TLS; local PostgreSQL can use disable.
DATABASE_SSL=require
# Optional CA file for verified Supabase TLS (public certificate included in certs/).
DATABASE_SSL_CA_FILE=certs/supabase-prod-ca-2021.crt
# Optional dedicated, disposable PostgreSQL database for integration tests.
TEST_DATABASE_URL=
TEST_DATABASE_SSL=disable
# Do not set NEXT_PUBLIC_ for any secrets.
WORKER_INTERVAL_MS=15000
