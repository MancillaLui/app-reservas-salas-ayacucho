{
  "name": "reservas-salas-ayacucho",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:integration:local": "tsx scripts/validacion/test-postgres.ts",
    "test:verify": "tsx scripts/validacion/test-postgres.ts --all --coverage",
    "test:complete": "jest --config jest.all.config.cjs --runInBand --coverage",
    "preview:test": "tsx scripts/demostracion/preview-postgres.ts",
    "test:browser": "playwright test",
    "api:validate": "tsx scripts/validacion/validar-openapi.ts",
    "evidence": "tsx scripts/entrega/evidencias.ts",
    "evidence:real": "tsx scripts/entrega/evidencia-real.ts",
    "delivery:prepare": "python scripts/entrega/preparar-entrega.py",
    "db:migrate": "tsx scripts/base-datos/migrate.ts",
    "db:seed": "tsx scripts/base-datos/seed.ts",
    "worker": "tsx scripts/operacion/worker.ts",
    "repo:validate": "python scripts/validacion/verificar-estructura.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^17.0.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-dist": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@playwright/test": "^1.65.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "17.12.0-beta.19",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
